{
  "$defs": {
    "Provenance": {
      "description": "Records origin and currency of externally derived data.",
      "properties": {
        "assumption_fields": {
          "items": {
            "type": "string"
          },
          "title": "Assumption Fields",
          "type": "array"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "source_type",
        "source_name",
        "fetched_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "fixture",
        "recorded",
        "live"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SourceQuality": {
      "enum": [
        "verified",
        "stale",
        "assumed",
        "unavailable"
      ],
      "title": "SourceQuality",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "manual",
        "catalog",
        "fixture",
        "forecast",
        "measured",
        "derived",
        "not_configured"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "description": "Normalized space-weather observation.",
  "properties": {
    "dst_index_nt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Dst index in nT",
      "title": "Dst Index Nt"
    },
    "f107_sfu": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Solar flux F10.7 in SFU",
      "title": "F107 Sfu"
    },
    "fetched_at": {
      "description": "Time the data was fetched (UTC)",
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "kp_index": {
      "description": "Planetary K-index (0–9)",
      "maximum": 9.0,
      "minimum": 0.0,
      "title": "Kp Index",
      "type": "number"
    },
    "observed_at": {
      "description": "Time the observation was made (UTC)",
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "raw_payload_hash": {
      "description": "SHA-256 hex digest of the raw source payload",
      "maxLength": 71,
      "minLength": 64,
      "title": "Raw Payload Hash",
      "type": "string"
    },
    "snapshot_id": {
      "description": "Unique snapshot ID (prefix: event_)",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_kind": {
      "$ref": "#/$defs/SourceKind"
    },
    "source_quality": {
      "$ref": "#/$defs/SourceQuality"
    },
    "valid_from": {
      "description": "Start of validity window (UTC)",
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "description": "End of validity window (UTC)",
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "valid_from",
    "valid_until",
    "observed_at",
    "fetched_at",
    "kp_index",
    "source_kind",
    "source_quality",
    "raw_payload_hash",
    "provenance"
  ],
  "title": "SpaceWeatherSnapshot",
  "type": "object"
}
